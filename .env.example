# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated Telegram user IDs that OWN the bot (required). Admins are
# pre-approved and can approve/decline other users' access requests.
# Find your ID by messaging @userinfobot. The bot rejects everyone if empty.
ADMIN_IDS=11111111,22222222

# Optional: comma-separated public sticker-pack names scanned for premium
# (custom) emoji used in the styled control panel. Leave empty to use the
# built-in defaults. Where custom emoji aren't available the bot falls back to
# plain unicode emoji automatically.
EMOJI_PACKS=

# How many numbers to process per browser session (default 10)
NUMBERS_PER_SESSION=10

# How many browser sessions run in parallel (default 2)
CONCURRENT_SESSIONS=2

# Keep re-running rounds until /stop is sent (default false)
LOOP_FOREVER=false

# Run the browser headless. Must stay true on a headless server (default true).
HEADLESS=true

# Optional Playwright browser channel, e.g. "chrome". Leave empty to use
# the bundled Chromium (required on this server).
BROWSER_CHANNEL=

# Password used on every registration
FIXED_PASSWORD=Hadii@2024
